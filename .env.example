# SyncMind environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# See docs/DEPLOYMENT.md section 2 for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth (sign-in only: email/profile scopes, no Gmail/Calendar API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, hex: openssl rand -hex 32
CRON_SECRET=

# --- Free-tier quota ceilings (per user, per UTC day) ---
# Confirmed 2026-07-28 at console.groq.com -> Limits, org base tier. See
# docs/AI-PIPELINE.md section 7 -- these are real numbers, not placeholders.
# Note: Groq also enforces tighter per-minute/per-hour caps (12k tokens/min on
# llama-3.3-70b-versatile, 7200 audio-sec/hour on whisper-large-v3-turbo) that
# these daily-only env vars do not capture on their own.
GROQ_DAILY_AUDIO_SECONDS=28800
GROQ_DAILY_ASR_CALLS=2000
GROQ_DAILY_LLM_CALLS=1000
GROQ_DAILY_LLM_TOKENS=100000
# llama-3.1-8b-instant (Ask this meeting) -- its own, much higher ceiling, separate
# from the 70B analysis/email bucket above.
GROQ_DAILY_ASK_CALLS=14400
GROQ_DAILY_ASK_TOKENS=500000

# --- Optional: error monitoring (Sentry free tier, 5k errors/month) ---
# A DSN isn't a secret -- Sentry's own docs confirm it's meant to be embedded
# client-side -- so this one var is read by instrumentation-client.ts,
# sentry.server.config.ts, and sentry.edge.config.ts. Unset = Sentry disabled, no
# build or runtime impact either way.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, source-map upload. Never referenced from client code.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
