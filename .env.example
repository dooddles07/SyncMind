# SyncMind environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# See docs/DEPLOYMENT.md section 2 for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth (Gmail drafts + Calendar events) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, hex: openssl rand -hex 32
CRON_SECRET=

# --- Free-tier quota ceilings (per user, per UTC day) ---
GROQ_DAILY_AUDIO_SECONDS=21600
GROQ_DAILY_ASR_CALLS=60
GROQ_DAILY_LLM_CALLS=80
GROQ_DAILY_LLM_TOKENS=400000

# --- Optional ---
SENTRY_DSN=
