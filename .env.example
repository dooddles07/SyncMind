# SyncMind environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# See docs/DEPLOYMENT.md section 2 for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth (sign-in only: email/profile scopes, no Gmail/Calendar API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, hex: openssl rand -hex 32
CRON_SECRET=

# --- Free-tier quota ceilings (per user, per UTC day) ---
# Confirmed 2026-07-28 at console.groq.com -> Limits, org base tier. See
# docs/AI-PIPELINE.md section 7 -- these are real numbers, not placeholders.
# Note: Groq also enforces tighter per-minute/per-hour caps (12k tokens/min on
# llama-3.3-70b-versatile, 7200 audio-sec/hour on whisper-large-v3-turbo) that
# these daily-only env vars do not capture on their own.
GROQ_DAILY_AUDIO_SECONDS=28800
GROQ_DAILY_ASR_CALLS=2000
GROQ_DAILY_LLM_CALLS=1000
GROQ_DAILY_LLM_TOKENS=100000

# --- Optional ---
SENTRY_DSN=
